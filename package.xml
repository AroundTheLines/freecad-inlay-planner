<?xml version="1.0" encoding="UTF-8"?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
  <name>InlayPlanner</name>
  <description>Paired wooden inlay paths from filled SVG artwork, using native FreeCAD CAM.</description>
  <version>0.1.0</version>
  <date>2026-09-28</date>
  <maintainer>Qile Wang</maintainer>
  <license file="LICENSE">MIT</license>
  <icon>resources/inlay.svg</icon>
  <!-- FreeCAD discovers startup modules through workbench content entries.
       InitGui.py augments this existing workbench and does not register another. -->
  <content>
    <workbench>
      <name>CAM commands</name>
      <classname>CAMWorkbench</classname>
      <subdirectory>./</subdirectory>
      <icon>resources/inlay.svg</icon>
      <description>Adds Create Inlay to the existing CAM workbench.</description>
    </workbench>
  </content>
  <freecadmin>1.1.3</freecadmin>
  <pythonmin>3.11</pythonmin>
</package>
